{
  "name": "repentista",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "repentista": "dist/infrastructure/cli/entrypoint.js"
  },
  "scripts": {
    "openspec:cli": "env OPENSPEC_TELEMETRY=0 DO_NOT_TRACK=1 openspec",
    "openspec:validate-proposal": "node .openspec-shipper/scripts/validate-openspec-proposal.mjs",
    "lint:branch": "node .openspec-shipper/scripts/validate-branch-name.mjs",
    "lint:commits": "commitlint --from origin/$(git branch --show-current) --to HEAD",
    "build": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx src/infrastructure/cli/entrypoint.ts",
    "start": "node dist/infrastructure/cli/entrypoint.js"
  },
  "dependencies": {
    "silabacion": "0.5.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@fission-ai/openspec": "^1.11.0",
    "@types/node": "^22.20.1",
    "openspec-shipper": "^1.0.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
